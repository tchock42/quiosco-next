
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {            // codigo para generar la tabla Category | una Categoria tiene muchos productos
  id  Int   @id   @default(autoincrement())
  name  String
  slug  String
  products    Product[]
}

